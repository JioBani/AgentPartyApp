    "test:e2e:wsl-codex-auth-switch": "npm run build && node scripts/e2e-wsl-codex-auth-switch.mjs",
    "test:e2e:party-delete": "npm run build && node scripts/qa-app-party-delete-e2e.mjs",
    "test:e2e:subagents": "npm run build && node scripts/e2e-subagents.mjs",
    "test:e2e:party-store": "npm run build && node scripts/e2e-party-store.mjs",
    "test:e2e:party-coordination": "npm run build && node scripts/e2e-party-coordination.mjs",
    "test:e2e:discovery": "npm run build && node scripts/e2e-discovery.mjs",
    "test:e2e:multiprocess": "npm run build && node scripts/e2e-multiprocess.mjs",
    "test:e2e:context-usage": "npm run build && node scripts/e2e-context-usage.mjs",
    "test:e2e:token-usage": "npm run build && node scripts/e2e-token-usage.mjs",
    "test:e2e:member-respawn": "npm run build && node scripts/e2e-member-respawn.mjs",
    "test:e2e:live-session-reopen": "npm run build && node scripts/e2e-live-session-reopen.mjs",
    "test:e2e:live-cross-harness": "npm run build && node scripts/e2e-live-cross-harness.mjs",
    "test:e2e:live-deepseek": "npm run build && node scripts/e2e-live-deepseek.mjs",
    "test:e2e:usage-poller": "npm run build && node scripts/e2e-usage-poller.mjs",
    "test:e2e:live-fable": "npm run build && node scripts/e2e-live-fable.mjs",
    "test:e2e:live-opus5": "npm run build && node scripts/e2e-live-opus5.mjs",
    "test:e2e:live-claude-opus-routing": "npm run build && node scripts/e2e-live-claude-opus-routing.mjs",
    "test:e2e:font-zoom": "npm run build && node scripts/e2e-font-zoom.mjs",
    "test:e2e:two-window": "npm run build && node scripts/e2e-two-window-party.mjs",
    "test:e2e:permission-persist": "npm run build && node scripts/e2e-permission-persist.mjs",
    "test:e2e:permission-ui": "npm run build && node scripts/e2e-member-permission-ui.mjs",
    "test:e2e:discord-bridge": "npm run build && node scripts/e2e-discord-bridge.mjs",
    "test:e2e:auto-compact": "npm run build && node scripts/e2e-auto-compact.mjs",
    "test:e2e:compact": "npm run build && node scripts/e2e-compact.mjs",
    "test:e2e:usage-limits": "npm run build && node scripts/e2e-usage-limits.mjs",
    "test:e2e:sidebar-overflow": "npm run build && node scripts/e2e-sidebar-overflow.mjs",
    "test:e2e:usage-unpriced": "npm run build && node scripts/e2e-usage-unpriced.mjs",
    "test:subagents": "node scripts/qa-subagents.mjs",
    "test:subagent-tracker": "node scripts/qa-subagent-tracker.mjs",
    "test:party-store": "node scripts/qa-party-store.mjs",
    "test:render": "node scripts/qa-render.mjs",
    "test:askq": "node scripts/qa-askq.mjs",
    "test:interaction": "node scripts/qa-interaction-api.mjs",
    "test:catalog": "node scripts/qa-model-catalog.mjs",
    "test:backend": "node scripts/qa-model-backend.mjs",
    "test:harness-protocol": "node scripts/qa-harness-protocol.mjs",
    "test:subscription-auth": "node scripts/qa-subscription-auth.mjs",
    "test:subscription-install": "node scripts/qa-subscription-proxy-install.mjs",
    "test:wsl-codex-bridge": "node scripts/qa-wsl-codex-bridge.mjs",
    "test:party-bridge": "node scripts/qa-party-bridge.mjs",
    "test:party-mock": "node scripts/qa-party-mock.mjs",
    "test:member-wizard": "node scripts/qa-member-wizard.mjs",
    "test:member-remove": "node scripts/qa-member-remove.mjs",
    "test:channel-render": "node scripts/qa-channel-render.mjs",
    "test:markdown": "node scripts/qa-markdown.mjs",
    "test:tool-output": "node scripts/qa-tool-output.mjs",
    "test:command-palette": "node scripts/qa-command-palette.mjs",
    "test:default-profile": "node scripts/qa-default-profile.mjs",
    "test:harness-defaults": "node scripts/qa-harness-defaults.mjs",
    "test:codex-policy": "node scripts/qa-codex-policy.mjs",
    "test:codex-approval": "node scripts/qa-codex-approval.mjs",
    "test:codex-items": "node scripts/qa-codex-items.mjs",
    "test:codex-discovery": "node scripts/qa-codex-discovery.mjs",
    "test:codex-diagnostics": "node scripts/qa-codex-diagnostics.mjs",
    "test:codex-models": "node scripts/qa-codex-models.mjs",
    "test:cursor": "npm run build && node scripts/qa-cursor-adapter.mjs",
    "test:codex-dedup": "node scripts/qa-codex-dedup.mjs",
    "test:codex-party-tools": "node scripts/qa-codex-party-tools.mjs",
    "test:stall-status": "node scripts/qa-stall-status.mjs",
    "test:context-meter": "node scripts/qa-context-meter.mjs",
    "test:message-preview": "node scripts/qa-message-preview.mjs",
    "test:session-history": "node scripts/qa-session-history.mjs",
    "test:vision": "node scripts/qa-vision.mjs",
    "test:composer-vision": "node scripts/qa-composer-vision.mjs",
    "test:user-message": "node scripts/qa-user-message.mjs",
    "test:mcp": "node scripts/qa-mcp.mjs",
    "test:mcp-modal": "node scripts/qa-mcp-modal.mjs",
    "test:usage-limits": "node scripts/qa-usage-limits.mjs",
    "test:auto-compact": "node scripts/qa-auto-compact.mjs",
    "test:layout": "node scripts/qa-layout.mjs",
    "test:workspace": "node scripts/qa-workspace-location.mjs",
    "test:wsl-engine": "node scripts/qa-wsl-engine.mjs",
    "test:engine-rpc": "node scripts/qa-engine-rpc.mjs",
    "test:wsl-remote": "node scripts/qa-wsl-remote.mjs",
    "test:wsl-cli": "node scripts/qa-wsl-cli.mjs",
    "test:wsl-session": "node scripts/qa-wsl-session.mjs",
    "test:wsl-subagents": "node scripts/qa-wsl-subagents.mjs",
    "test:compact-dialog": "node scripts/qa-compact-dialog.mjs",
    "test:ui": "npm run test:workspace && npm run test:layout && npm run test:render && npm run test:askq && npm run test:interaction && npm run test:catalog && npm run test:backend && npm run test:subscription-auth && npm run test:subscription-auth-url && npm run test:party-bridge && npm run test:party-mock && npm run test:member-wizard && npm run test:member-remove && npm run test:member-start-model && npm run test:channel-render && npm run test:markdown && npm run test:tool-output && npm run test:subagents && npm run test:subagent-tracker && npm run test:party-store && npm run test:transcript-append && npm run test:command-palette && npm run test:default-profile && npm run test:harness-defaults && npm run test:codex-policy && npm run test:codex-approval && npm run test:codex-items && npm run test:codex-discovery && npm run test:codex-diagnostics && npm run test:codex-models && npm run test:codex-dedup && npm run test:codex-party-tools && npm run test:stall-status && npm run test:interrupt-recovery && npm run test:context-meter && npm run test:message-preview && npm run test:session-history && npm run test:vision && npm run test:composer-vision && npm run test:user-message && npm run test:mcp && npm run test:mcp-modal && npm run test:usage-limits && npm run test:auto-compact && npm run test:compact-dialog && npm run test:gate-reviewer-reasoning && npm run test:engine-host-channel && npm run test:gate-fail-open && npm run test:party-gate-scope",
    "start": "node scripts/launch-electron.mjs",
    "start:qa": "cross-env AGENTPARTY_QA=1 node scripts/launch-electron.mjs",
    "start:dev": "cross-env AGENTPARTY_RENDERER_URL=http://127.0.0.1:5173 node scripts/launch-electron.mjs",
    "qa:seed": "node scripts/qa-frontend.mjs",
    "dist:win": "npm run build && electron-builder --win --x64",
    "package:win": "node scripts/package-win.mjs",
    "test:member-start-model": "node scripts/qa-member-start-model.mjs",
    "test:transcript-append": "node scripts/qa-transcript-append.mjs",
    "test:interrupt-recovery": "node scripts/qa-interrupt-recovery.mjs",
    "test:resume-target": "node scripts/qa-resume-target.mjs",
    "test:subscription-auth-url": "node scripts/qa-subscription-auth-url.mjs",
    "test:subscription-disconnect-ui": "node scripts/qa-subscription-disconnect-ui.mjs",
    "test:codex-authentication-store": "node scripts/qa-codex-authentication-store.mjs",
    "test:gate-reviewer-reasoning": "node scripts/qa-gate-reviewer-reasoning.mjs",
    "test:engine-host-channel": "node scripts/qa-engine-host-channel.mjs",
    "test:gate-fail-open": "node scripts/qa-gate-fail-open-notice.mjs",
    "test:party-gate-scope": "node scripts/qa-party-gate-scope.mjs"
  },
  "build": {
    "appId": "party.agentparty.desktop",
    "productName": "AgentParty",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-renderer/**",
      "docs/**",
      "package.json",
      "README.md"
    ],
    "asarUnpack": [
      "dist/engine-server.mjs"
    ],
    "extraResources": [
      {
        "from": "scripts/agent-party",
        "to": "bin/agent-party"
      },
      {
        "from": "scripts/agent-party-launcher.mjs",
        "to": "bin/agent-party-launcher.mjs"
      },
      {
        "from": "scripts/agentparty-codex-mcp-server.mjs",
        "to": "bin/agentparty-codex-mcp-server.mjs"
      },
      {
        "from": "scripts/agentparty-acp-mcp-relay.mjs",
        "to": "bin/agentparty-acp-mcp-relay.mjs"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "include": "build/installer.nsh"
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.186",
    "@vitejs/plugin-react": "^4.5.2",
    "extract-zip": "^2.0.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "jsdom": "^29.1.1",
    "typescript": "^5.8.3",
    "vite": "^6.0.7"
  }
}
